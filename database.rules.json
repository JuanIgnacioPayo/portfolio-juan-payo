{
  "rules": {
    "content": { ".read": true, ".write": "auth != null" },
    "playground": { ".read": true, ".write": "auth != null" },
    "newsStatus": { ".read": true, ".write": "auth != null" },
    "agentStatus": { ".read": true, ".write": "auth != null" },
    "usage_logs": { ".read": true, ".write": "auth != null" },
    "config": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "messages": {
      ".read": "auth != null",
      "$messageId": {
        ".write": "!data.exists()"
      }
    }
  }
}
